% Maintained by hand; see CONTRIBUTING.md.
\name{CECclassif}
\alias{CECclassif}
\title{Cluster one dataset at one C and lambda}
\description{
Fit a hard partition by CEM or by ranking hard MAP partitions generated by a bank of constrained soft EM fits. Optimization and order penalization are separate choices.
}
\usage{
CECclassif(Z, lambda = 1, C = 1, Cquali = Inf, r0 = NULL, Nshots = 100, Nloop = 1000, familyType = "gaussAndDiscreteVector", 
    sizeMaxOutlier = 0, autoRegroupOutliers = FALSE, displayRemainingTime = FALSE, focus = NULL, 
    backend_data = NULL, n_cores = 1L, shot_strategy = c("current", "independent"), optimization = c("cem", 
        "em_bank"), penalty = c("none", "bic"), optimizer_control = list())
}
\arguments{
\item{Z}{A numeric vector, matrix or data frame with observations in rows. Numeric Gaussian engines require finite complete data. The historical unpenalized CEM also accepts data frames with factor columns for categorical variables.}
\item{lambda}{Finite positive weight of the group-mass entropy.}
\item{C}{Finite positive ceiling on each quantitative reference density, not on the mixture density. Its numerical scale depends on the units of the data.}
\item{Cquali}{Historical qualitative probability-floor control: a finite value imposes a floor 1/Cquali on observed category probabilities and renormalizes them; it must exceed the number of observed levels in each group. \code{Inf} leaves it inactive. Qualitative-floor activation is tracked separately. New numeric engines require \code{Inf}.}
\item{r0}{Initial number of groups for historical CEM. Supplies the default \code{Rmax} for the numeric engines; see \link{CECoptimizers}.}
\item{Nshots}{Number of historical CEM starts; default \code{Ninit} for numeric engines. For EM banks this is the number of starts at each order, not a total over orders.}
\item{Nloop}{Historical iteration limit; default \code{max_iter} for numeric engines.}
\item{familyType}{Historical reference family: \code{"gaussUniv"}, \code{"gaussVector"}, \code{"discreteVector"}, or \code{"gaussAndDiscreteVector"}. New numeric engines fit full-covariance Gaussians (a scalar variance in dimension one). They do not implement categorical or mixed references.}
\item{sizeMaxOutlier}{Historical CEM outlier-group size control; use zero with the new numeric engines.}
\item{autoRegroupOutliers}{Historical post-fit regrouping flag. Must be \code{FALSE} for the new numeric engines.}
\item{displayRemainingTime}{Historical CEM progress display. It does not activate progress output for the new numeric engines.}
\item{focus}{Optional historical column index for conditioning on a factor feature. Leave \code{NULL} with the new engines.}
\item{backend_data}{Optional internally preprocessed numeric/factor backend for repeated historical calls on the same data. Ordinary users should leave NULL. Not used by the new numeric engines.}
\item{n_cores}{Historical independent-shot CEM parallelism, with a sequential fallback on non-Unix platforms. A direct call to a new numeric engine requires one core. Use \code{CECfitBoundGrid(n_cores=...)} to parallelize independent repetitions, including on Windows.}
\item{shot_strategy}{Historical CEM start strategy: \code{"current"} permits reuse of previous shots, while \code{"independent"} starts every shot without a previous allocation. Not used by the new numeric engines.}
\item{optimization}{\code{"cem"} for hard CEM; \code{"em_bank"} for a constrained EM candidate bank followed by MAP and hard refitting.}
\item{penalty}{\code{"none"} or \code{"bic"}, independently of the optimizer. BIC is the Gaussian order penalty defined in \link{CECoptimizers}.}
\item{optimizer_control}{Named list of budgets, bounds and seeds. See \link{CECoptimizers} for every field, defaults and method-specific meaning.}
}
\value{
A list with \code{clusters} (one integer label per observation), \code{REO}
(occupied group count), \code{params}, \code{Hphi}, \code{objective},
\code{entropy}, \code{penalty_value}, \code{optimization} and \code{penalty}.
The EM route also returns \code{bank} and \code{selected_candidate}; numeric
CEM returns \code{solver} with its search and descent records. The historical
route may return \code{NULL} if no valid fit is found. Labels have no intrinsic order.
}
\details{
For each hard candidate, weights and Gaussian parameters are estimated
under the target C before scoring. \code{objective} is the empirical composite
entropy plus the relative BIC penalty, and \code{Hphi=objective/lambda}.
The soft EM likelihood is used only to generate candidates. Neither optimizer
certifies the global minimum over all partitions.

For \code{optimization="cem", penalty="none"}, an empty control list or a
list containing only \code{seed} retains historical CEM. Other control fields
select the consolidated numeric CEM search. An explicit control seed is local
to the call and restores the caller's random-number state afterwards.
The group count can be smaller than the initialization order after hard allocation.
}
\seealso{\link{CECoptimizers}, \link{CECfitBoundGrid}, \link{CECrescoreGrid}.}
\examples{
set.seed(12)
X <- cbind(x = c(rnorm(30, -2, 0.5), rnorm(30, 2, 0.5)),
           y = rnorm(60, sd = 0.5))
fit <- CECclassif(X, C = 1, lambda = 0.8,
  optimization = "em_bank", penalty = "none",
  optimizer_control = list(Rmax = 3, Ninit = 2, max_iter = 30, seed = 4))
table(fit$clusters)
c(REO = fit$REO, objective = fit$objective)
}
